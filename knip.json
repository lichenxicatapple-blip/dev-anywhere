{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["scripts/dev/restart.sh", "scripts/dev/health.sh"],
  "ignore": ["scripts/lib/resolve-dev-profile.mjs"],
  "workspaces": {
    "apps/relay": {
      "entry": ["scripts/verify-relay.ts"],
      "ignoreDependencies": ["pino", "zod"]
    },
    "apps/web": {
      "entry": [
        "e2e/**/*.{ts,d.ts,mjs}",
        "public/notification-sw.js",
        "src/types/echogarden-fvad-wasm.d.ts",
        "src/types/jmuxer.d.ts"
      ],
      "ignore": ["src/components/ui/**"]
    }
  }
}
